        {
          "name": "3. Negative Update - Missing Auth Token & Verify Booking Unchanged (PUT /booking/:id)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Provision an isolated booking for this request only, so it can run on its own or in any order",
                  "const baseUrl = pm.variables.get('baseUrl');",
                  "pm.sendRequest({",
                  "    url: `${baseUrl}/booking`,",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json', 'Accept': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            firstname: 'Immutable',",
                  "            lastname: 'Target',",
                  "            totalprice: 111,",
                  "            depositpaid: true,",
                  "            bookingdates: { checkin: pm.variables.get('checkinDate'), checkout: pm.variables.get('checkoutDate') },",
                  "            additionalneeds: 'None'",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        pm.collectionVariables.set('negPutTargetId', res.json().bookingid);",
                  "    }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthorized PUT is rejected with 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "const baseUrl = pm.variables.get('baseUrl');",
                  "const targetId = pm.variables.get('negPutTargetId');",
                  "",
                  "// Verify the target booking was NOT modified by the unauthorized PUT, then clean it up",
                  "pm.sendRequest({",
                  "    url: `${baseUrl}/booking/${targetId}`,",
                  "    method: 'GET',",
                  "    header: { 'Accept': 'application/json' }",
                  "}, function (err, res) {",
                  "    pm.test('Target booking state remains completely unchanged after rejected PUT', function () {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(res.code).to.eql(200);",
                  "        const data = res.json();",
                  "        pm.expect(data.firstname).to.eql('Immutable');",
                  "        pm.expect(data.lastname).to.eql('Target');",
                  "        pm.expect(data.totalprice).to.eql(111);",
                  "    });",
                  "",
                  "    // Teardown: authenticate with a fresh token (independent of the chained workflow) and delete the target",
                  "    const cleanupId = pm.variables.get('negPutTargetId');",
                  "    if (cleanupId) {",
                  "        pm.sendRequest({",
                  "            url: `${baseUrl}/auth`,",
                  "            method: 'POST',",
                  "            header: { 'Content-Type': 'application/json' },",
                  "            body: {",
                  "                mode: 'raw',",
                  "                raw: JSON.stringify({ username: pm.variables.get('authUsername'), password: pm.variables.get('authPassword') })",
                  "            }",
                  "        }, function (authErr, authRes) {",
                  "            const freshToken = !authErr && authRes.code === 200 ? authRes.json().token : null;",
                  "            if (!freshToken) { return; }",
                  "            pm.sendRequest({",
                  "                url: `${baseUrl}/booking/${cleanupId}`,",
                  "                method: 'DELETE',",
                  "                header: { 'Cookie': `token=${freshToken}` }",
                  "            }, function () {",
                  "                pm.collectionVariables.unset('negPutTargetId');",
                  "            });",
                  "        });",
                  "    }",
                  "    ",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Hacked\",\n  \"lastname\": \"User\",\n  \"totalprice\": 999,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkinDate}}\",\n    \"checkout\": \"{{checkoutDate}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{negPutTargetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{negPutTargetId}}"
              ]
            }
          }
        },
