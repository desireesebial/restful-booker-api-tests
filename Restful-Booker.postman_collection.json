                  "    pm.test('Booking still exists after the rejected DELETE', function () {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(getRes.code).to.eql(200);",
                  "        pm.expect(getRes.json().firstname).to.eql('Immutable');",
                  "    });",
                  "",
                  "    // Clean up: get a fresh token and delete the test booking",
                  "    const cleanupId = pm.variables.get('negDeleteTargetId');",
                  "    if (cleanupId) {",
                  "        pm.sendRequest({",
                  "            url: `${baseUrl}/auth`,",
                  "            method: 'POST',",
                  "            header: { 'Content-Type': 'application/json' },",
                  "            body: {",
                  "                mode: 'raw',",
                  "                raw: JSON.stringify({ username: pm.variables.get('authUsername'), password: pm.variables.get('authPassword') })",
                  "            }",
                  "        }, function (authErr, authRes) {",
                  "            const freshToken = !authErr && authRes.code === 200 ? authRes.json().token : null;",
                  "            if (!freshToken) { return; }",
                  "            pm.sendRequest({",
                  "                url: `${baseUrl}/booking/${cleanupId}`,",
                  "                method: 'DELETE',",
                  "                header: { 'Cookie': `token=${freshToken}` }",
                  "            }, function () {",
                  "                pm.collectionVariables.unset('negDeleteTargetId');",
                  "            });",
                  "        });",
                  "    }",
                  "    ",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Create a booking just for this request so it can run on its own",
                  "const baseUrl = pm.variables.get('baseUrl');",
                  "pm.sendRequest({",
                  "    url: `${baseUrl}/booking`,",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json', 'Accept': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            firstname: 'Immutable',",
                  "            lastname: 'Target',",
                  "            totalprice: 111,",
                  "            depositpaid: true,",
                  "            bookingdates: { checkin: pm.variables.get('checkinDate'), checkout: pm.variables.get('checkoutDate') },",
                  "            additionalneeds: 'None'",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        pm.collectionVariables.set('negDeleteTargetId', res.json().bookingid);",
                  "    }",
                  "});"
                ]
              }
