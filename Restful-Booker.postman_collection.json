  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Booking dates: tomorrow, +6 days and +10 days. Regenerated once a day.",
          "const today = new Date().toISOString().split('T')[0];",
          "if (pm.collectionVariables.get('datesGeneratedOn') !== today) {",
          "    const addDays = (days) => new Date(Date.now() + days * 86400000).toISOString().split('T')[0];",
          "    pm.collectionVariables.set('checkinDate', addDays(1));",
          "    pm.collectionVariables.set('checkoutDate', addDays(6));",
          "    pm.collectionVariables.set('updatedCheckoutDate', addDays(10));",
          "    pm.collectionVariables.set('datesGeneratedOn', today);",
          "}",
          "",
          "// JSON schemas used by the tests",
          "const datePattern = '^\\\\d{4}-\\\\d{2}-\\\\d{2}$';",
          "const bookingSchema = {",
          "    type: 'object',",
          "    required: ['firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates'],",
          "    properties: {",
          "        firstname: { type: 'string', minLength: 1 },",
          "        lastname: { type: 'string', minLength: 1 },",
          "        totalprice: { type: 'number' },",
          "        depositpaid: { type: 'boolean' },",
          "        bookingdates: {",
          "            type: 'object',",
          "            required: ['checkin', 'checkout'],",
          "            properties: {",
          "                checkin: { type: 'string', pattern: datePattern },",
          "                checkout: { type: 'string', pattern: datePattern }",
          "            }",
          "        },",
          "        additionalneeds: { type: 'string' }",
          "    }",
          "};",
          "pm.collectionVariables.set('bookingSchema', JSON.stringify(bookingSchema));",
          "pm.collectionVariables.set('createResponseSchema', JSON.stringify({",
          "    type: 'object',",
          "    required: ['bookingid', 'booking'],",
          "    properties: { bookingid: { type: 'number' }, booking: bookingSchema }",
          "}));",
          "pm.collectionVariables.set('tokenSchema', JSON.stringify({",
          "    type: 'object',",
          "    required: ['token'],",
          "    properties: { token: { type: 'string', minLength: 1 } }",
          "}));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Booking lifecycle (chained)",
      "item": [
        {
          "name": "1. Get token (POST /auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Type is JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/json/);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test('Token is a non-empty string', function () {",
                  "    pm.expect(jsonData).to.be.an('object');",
                  "    pm.expect(jsonData.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('Response matches the token schema', function () {",
                  "    pm.response.to.have.jsonSchema(JSON.parse(pm.variables.get('tokenSchema')));",
                  "});",
                  "",
                  "pm.collectionVariables.set('authToken', jsonData.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{authUsername}}\",\n  \"password\": \"{{authPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            }
          }
        },
        {
          "name": "2. Create booking (POST /booking)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Type is JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/json/);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Response matches the create-booking schema', function () {",
                  "    pm.response.to.have.jsonSchema(JSON.parse(pm.variables.get('createResponseSchema')));",
                  "});",
                  "",
                  "pm.test('Booking has the values we sent', function () {",
                  "    pm.expect(res.booking.firstname).to.eql('John');",
                  "    pm.expect(res.booking.lastname).to.eql('Doe');",
                  "    pm.expect(res.booking.totalprice).to.eql(150);",
                  "    pm.expect(res.booking.depositpaid).to.eql(true);",
                  "    pm.expect(res.booking.bookingdates.checkin).to.eql(pm.variables.get('checkinDate'));",
                  "    pm.expect(res.booking.bookingdates.checkout).to.eql(pm.variables.get('checkoutDate'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('bookingId', res.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"John\",\n  \"lastname\": \"Doe\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkinDate}}\",\n    \"checkout\": \"{{checkoutDate}}\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          }
        },
        {
          "name": "3. Update booking (PUT /booking/:id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Type is JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/json/);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test('Response matches the booking schema', function () {",
                  "    pm.response.to.have.jsonSchema(JSON.parse(pm.variables.get('bookingSchema')));",
                  "});",
                  "pm.test('Response has the updated values', function () {",
                  "    pm.expect(res.firstname).to.eql('Jane');",
                  "    pm.expect(res.lastname).to.eql('Doe');",
                  "    pm.expect(res.totalprice).to.eql(275);",
                  "    pm.expect(res.depositpaid).to.eql(false);",
                  "    pm.expect(res.bookingdates.checkout).to.eql(pm.variables.get('updatedCheckoutDate'));",
                  "    pm.expect(res.additionalneeds).to.eql('Late Checkout');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Jane\",\n  \"lastname\": \"Doe\",\n  \"totalprice\": 275,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkinDate}}\",\n    \"checkout\": \"{{updatedCheckoutDate}}\"\n  },\n  \"additionalneeds\": \"Late Checkout\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          }
        },
        {
          "name": "4. Get booking, check the update (GET /booking/:id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Type is JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/json/);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test('Response matches the booking schema', function () {",
                  "    pm.response.to.have.jsonSchema(JSON.parse(pm.variables.get('bookingSchema')));",
                  "});",
                  "pm.test('Booking was saved with the updated values', function () {",
                  "    pm.expect(res.firstname).to.eql('Jane');",
                  "    pm.expect(res.lastname).to.eql('Doe');",
                  "    pm.expect(res.totalprice).to.eql(275);",
                  "    pm.expect(res.depositpaid).to.eql(false);",
                  "    pm.expect(res.bookingdates.checkin).to.eql(pm.variables.get('checkinDate'));",
                  "    pm.expect(res.bookingdates.checkout).to.eql(pm.variables.get('updatedCheckoutDate'));",
                  "    pm.expect(res.additionalneeds).to.eql('Late Checkout');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          }
        },
        {
          "name": "5. Delete booking, check it is gone (DELETE /booking/:id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// This API answers 201 for a successful delete",
                  "pm.test('Status is 201 (this API returns 201 for a delete)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const baseUrl = pm.variables.get('baseUrl');",
                  "const deletedId = pm.variables.get('bookingId');",
                  "",
                  "// Check the booking is really gone",
                  "pm.sendRequest({",
                  "    url: `${baseUrl}/booking/${deletedId}`,",
                  "    method: 'GET',",
                  "    header: { 'Accept': 'application/json' }",
                  "}, function (err, res) {",
                  "    pm.test('GET after delete returns 404', function () {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(res.code).to.eql(404);",
                  "    });",
                  "    pm.collectionVariables.unset('bookingId');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Negative tests",
      "item": [
        {
          "name": "N1. Wrong password (POST /auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Known quirk: a failed login still returns 200 with a reason in the body (401 would be normal)",
                  "pm.test('Status is 200 (the API does not return 401 here)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test('Body says Bad credentials and has no token', function () {",
                  "    pm.expect(res.reason).to.eql('Bad credentials');",
                  "    pm.expect(res).to.not.have.property('token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{authUsername}}\",\n  \"password\": \"wrong_password_999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            }
          }
        },
        {
          "name": "N2. Missing fields (POST /booking)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Known defect: missing fields give a server error (500), a 400 would be correct",
                  "pm.test('Status is 500 (known defect, should be 400)', function () {",
                  "    pm.response.to.have.status(500);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"John\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          }
        },
        {
          "name": "N3. Update without token (PUT /booking/:id)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Create a booking just for this request so it can run on its own",
                  "const baseUrl = pm.variables.get('baseUrl');",
                  "pm.sendRequest({",
                  "    url: `${baseUrl}/booking`,",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json', 'Accept': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            firstname: 'Immutable',",
                  "            lastname: 'Target',",
                  "            totalprice: 111,",
                  "            depositpaid: true,",
                  "            bookingdates: { checkin: pm.variables.get('checkinDate'), checkout: pm.variables.get('checkoutDate') },",
                  "            additionalneeds: 'None'",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        pm.collectionVariables.set('negPutTargetId', res.json().bookingid);",
                  "    }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PUT without token returns 403', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "const baseUrl = pm.variables.get('baseUrl');",
                  "const targetId = pm.variables.get('negPutTargetId');",
                  "",
                  "// Check the booking was not changed, then clean up",
                  "pm.sendRequest({",
                  "    url: `${baseUrl}/booking/${targetId}`,",
                  "    method: 'GET',",
                  "    header: { 'Accept': 'application/json' }",
                  "}, function (err, res) {",
                  "    pm.test('Booking is unchanged after the rejected PUT', function () {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(res.code).to.eql(200);",
                  "        const data = res.json();",
                  "        pm.expect(data.firstname).to.eql('Immutable');",
                  "        pm.expect(data.lastname).to.eql('Target');",
                  "        pm.expect(data.totalprice).to.eql(111);",
                  "    });",
                  "",
                  "    // Clean up: get a fresh token and delete the test booking",
                  "    const cleanupId = pm.variables.get('negPutTargetId');",
                  "    if (cleanupId) {",
                  "        pm.sendRequest({",
                  "            url: `${baseUrl}/auth`,",
                  "            method: 'POST',",
                  "            header: { 'Content-Type': 'application/json' },",
                  "            body: {",
                  "                mode: 'raw',",
                  "                raw: JSON.stringify({ username: pm.variables.get('authUsername'), password: pm.variables.get('authPassword') })",
                  "            }",
                  "        }, function (authErr, authRes) {",
                  "            const freshToken = !authErr && authRes.code === 200 ? authRes.json().token : null;",
                  "            if (!freshToken) { return; }",
                  "            pm.sendRequest({",
                  "                url: `${baseUrl}/booking/${cleanupId}`,",
                  "                method: 'DELETE',",
                  "                header: { 'Cookie': `token=${freshToken}` }",
                  "            }, function () {",
                  "                pm.collectionVariables.unset('negPutTargetId');",
                  "            });",
                  "        });",
                  "    }",
                  "    ",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Hacked\",\n  \"lastname\": \"User\",\n  \"totalprice\": 999,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkinDate}}\",\n    \"checkout\": \"{{checkoutDate}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{negPutTargetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{negPutTargetId}}"
              ]
            }
          }
        },
