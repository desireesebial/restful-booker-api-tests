        {
          "name": "5. Negative Delete - Invalid Token, Verify Unchanged & Guaranteed Cleanup (DELETE /booking/:id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('DELETE with invalid token is rejected with 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "const baseUrl = pm.variables.get('baseUrl');",
                  "const targetId = pm.variables.get('negDeleteTargetId');",
                  "",
                  "// Prove the booking still exists after the rejected DELETE, then clean it up",
                  "pm.sendRequest({",
                  "    url: `${baseUrl}/booking/${targetId}`,",
                  "    method: 'GET',",
                  "    header: { 'Accept': 'application/json' }",
                  "}, function (err, getRes) {",
                  "    pm.test('Target booking still exists (200 OK) after rejected DELETE', function () {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(getRes.code).to.eql(200);",
                  "        pm.expect(getRes.json().firstname).to.eql('Immutable');",
                  "    });",
                  "",
                  "    // Teardown: authenticate with a fresh token (independent of the chained workflow) and delete the target",
                  "    const cleanupId = pm.variables.get('negDeleteTargetId');",
                  "    if (cleanupId) {",
                  "        pm.sendRequest({",
                  "            url: `${baseUrl}/auth`,",
                  "            method: 'POST',",
                  "            header: { 'Content-Type': 'application/json' },",
                  "            body: {",
                  "                mode: 'raw',",
                  "                raw: JSON.stringify({ username: pm.variables.get('authUsername'), password: pm.variables.get('authPassword') })",
                  "            }",
                  "        }, function (authErr, authRes) {",
                  "            const freshToken = !authErr && authRes.code === 200 ? authRes.json().token : null;",
                  "            if (!freshToken) { return; }",
                  "            pm.sendRequest({",
                  "                url: `${baseUrl}/booking/${cleanupId}`,",
                  "                method: 'DELETE',",
                  "                header: { 'Cookie': `token=${freshToken}` }",
                  "            }, function () {",
                  "                pm.collectionVariables.unset('negDeleteTargetId');",
                  "            });",
                  "        });",
                  "    }",
                  "    ",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Provision an isolated booking for this request only, so it can run on its own or in any order",
                  "const baseUrl = pm.variables.get('baseUrl');",
                  "pm.sendRequest({",
