        {
          "name": "5. Delete Booking & Verify Removal (DELETE /booking/:id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Note: Restful-Booker returns HTTP 201 Created on successful DELETE",
                  "pm.test('Status code is 201 Created (Restful-Booker delete confirmation)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const baseUrl = pm.variables.get('baseUrl');",
                  "const deletedId = pm.variables.get('bookingId');",
                  "",
                  "// Immediately verify via GET that the deleted booking returns 404 Not Found",
                  "pm.sendRequest({",
                  "    url: `${baseUrl}/booking/${deletedId}`,",
                  "    method: 'GET',",
                  "    header: { 'Accept': 'application/json' }",
                  "}, function (err, res) {",
                  "    pm.test('Follow-up GET on deleted bookingId returns 404 Not Found', function () {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(res.code).to.eql(404);",
